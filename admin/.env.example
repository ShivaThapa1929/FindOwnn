APP_NAME="Findownn Admin"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.hostingersite.com/admin
APP_KEY=change_this_to_random_secret_string

# ── Hostinger MySQL (hPanel → Websites → Databases → MySQL Databases) ──
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_findownn
DB_USERNAME=u123456789_findownn
DB_PASSWORD=your_mysql_password_here

SESSION_LIFETIME=120
SESSION_NAME=findownn_admin_session

TIMEZONE=Asia/Kolkata

MAIL_FROM=findownn@gmail.com
MAIL_FROM_NAME=Findownn

# Gmail SMTP (use App Password — Google Account → Security → 2-Step → App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=findownn@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls

CRON_SECRET=generate_random_secret_here

# ── OTP (mobile verification) ─────────────────────────────────────
# Recommended: firebase = free SMS via Google (no Fast2SMS wallet/DLT)
OTP_PROVIDER=firebase

# Firebase — https://console.firebase.google.com → Project settings → Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Venue owner OTP via SMS (OTP_PROVIDER=sms)
SMS_PROVIDER=smsalert
SMSALERT_API_KEY=your_smsalert_api_key
SMSALERT_SENDER_ID=YOUR6C
SMSALERT_ROUTE=transactional
# SMSALERT_DLT_TEMPLATE_ID=your_dlt_template_id

# Alternatives:
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_api_key
# FAST2SMS_ROUTE=auto
