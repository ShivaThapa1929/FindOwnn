    <!-- Date Navigation -->
    <div class="date-picker-nav">
        <button class="date-nav-btn" onclick="changeDate(-7)">
            <i class="fas fa-chevron-left"></i>
        </button>
        
        <div class="date-grid">
            <?php
            for ($i = 0; $i < 7; $i++) {
                $checkDate = date('Y-m-d', strtotime($date . " +{$i} days"));
                $isActive = $checkDate === $date ? 'active' : '';
                $dayName = date('D', strtotime($checkDate));
                $dayNum = date('d', strtotime($checkDate));
                $monthName = date('M', strtotime($checkDate));
                
                echo "<a href='?venue_id={$venue_id}&court_id={$court_id}&date={$checkDate}' class='date-card {$isActive}'>
                        <div class='date-day'>{$dayName}</div>
                        <div class='date-number'>{$dayNum}</div>
                        <div class='date-month'>{$monthName}</div>
                      </a>";
            }
            ?>
        </div>
        
        <button class="date-nav-btn" onclick="changeDate(7)">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>

    <!-- Time Slots Grid -->
    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-clock"></i> Available Times</h3>
            <div class="slot-legend">
                <span class="legend-item"><span class="legend-box available"></span> Available</span>
                <span class="legend-item"><span class="legend-box booked"></span> Booked</span>
                <span class="legend-item"><span class="legend-box selected"></span> Selected</span>
            </div>
        </div>
        <div class="card-body">
            <?php if (empty($slots)): ?>
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-calendar-times"></i>
                </div>
                <h3>No Time Slots Available</h3>
                <p>The venue may be closed on this day, or no slots are configured.</p>
                <a href="?venue_id=<?= $venue_id ?>&court_id=<?= $court_id ?>&date=<?= date('Y-m-d') ?>" class="btn btn-primary">
                    <i class="fas fa-calendar"></i> View Today's Slots
                </a>
            </div>
            <?php else: ?>
            <div class="time-slots-grid">
                <?php foreach ($slots as $slot): ?>
                <div class="time-slot <?= $slot['is_booked'] ? 'booked' : 'available' ?>" 
                     data-start="<?= $slot['start_time'] ?>" 
                     data-end="<?= $slot['end_time'] ?>"
                     <?= !$slot['is_booked'] ? 'onclick="selectSlot(this)"' : '' ?>>
                    <div class="slot-time">
                        <?= date('g:i A', strtotime($slot['start_time'])) ?> - <?= date('g:i A', strtotime($slot['end_time'])) ?>
                    </div>
                    
                    <?php if ($slot['is_booked']): ?>
                        <div class="slot-status booked-badge">
                            <i class="fas fa-check-circle"></i> Booked
                        </div>
                        <div class="slot-info">
                            <div class="booking-ref">Ref: <?= $slot['booking']['booking_reference'] ?></div>
                            <div class="booking-user">
                                <i class="fas fa-user"></i> <?= htmlspecialchars($slot['booking']['user_name']) ?>
                            </div>
                            <div class="booking-amount">
                                <i class="fas fa-rupee-sign"></i> ₹<?= number_format($slot['booking']['total_amount']) ?>
                            </div>
                            <div class="slot-actions">
                                <a href="/admin/bookings/show?id=<?= $slot['booking']['id'] ?>" class="btn-slot-action" title="View Details">
                                    <i class="fas fa-eye"></i> View
                                </a>
                            </div>
                        </div>
                    <?php else: ?>
                        <div class="slot-status available-badge">
                            <i class="fas fa-circle"></i> Available
                        </div>
                        <div class="slot-price">₹<?= number_format($court['price_per_hour']) ?></div>
                        <button class="btn-book-slot" onclick="bookSlotDirect(this); event.stopPropagation();">
                            <i class="fas fa-plus-circle"></i> Book Now
                        </button>
                    <?php endif; ?>
                </div>
                <?php endforeach; ?>
            </div>
            <?php endif; ?>
        </div>
    </div>

    <!-- Selected Slot Action -->
    <div class="selected-slot-action" id="selectedSlotAction" style="display: none;">
        <div class="selected-info">
            <div>
                <strong>Selected Time:</strong>
                <span id="selectedTime"></span>
            </div>
            <div>
                <strong>Price:</strong>
                <span id="selectedPrice">₹<?= number_format($court['price_per_hour']) ?></span>
