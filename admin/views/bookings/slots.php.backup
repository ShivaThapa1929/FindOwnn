    <?php if ($venue_id && $court_id && $venue && $court): ?>
    <!-- Booking Stats Summary -->
    <div class="stats-summary">
        <?php
        $totalSlots = count($slots);
        $bookedSlots = count(array_filter($slots, fn($s) => $s['is_booked']));
        $availableSlots = $totalSlots - $bookedSlots;
        $occupancyRate = $totalSlots > 0 ? round(($bookedSlots / $totalSlots) * 100) : 0;
        $totalRevenue = array_sum(array_map(fn($s) => $s['is_booked'] ? ($s['booking']['total_amount'] ?? 0) : 0, $slots));
        ?>
        <div class="stat-card">
            <div class="stat-icon available-color">
                <i class="fas fa-calendar-day"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value"><?= $totalSlots ?></div>
                <div class="stat-label">Total Slots</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon booked-color">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value"><?= $bookedSlots ?></div>
                <div class="stat-label">Booked</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon available-color">
                <i class="fas fa-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value"><?= $availableSlots ?></div>
                <div class="stat-label">Available</div>
