            <div class="stat-icon revenue-color">
                <i class="fas fa-rupee-sign"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">₹<?= number_format($totalRevenue) ?></div>
                <div class="stat-label">Revenue (Today)</div>
            </div>
        </div>
    </div>

