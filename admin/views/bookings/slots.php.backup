    padding: 0.5rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    transition: all 0.3s;
}

.btn-slot-action:hover {
    background: rgba(34, 197, 94, 0.25);
    transform: translateY(-1px);
}

.selected-slot-action {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(15, 25, 18, 0.98);
    border-top: 2px solid #22c55e;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 1000;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.5);
}

.selected-info {
    display: flex;
    gap: 2rem;
    color: #f0fdf4;
}

.selected-info strong {
    color: #a3c4af;
    margin-right: 0.5rem;
}

@media (max-width: 768px) {
    .slot-filter-form .form-row {
        grid-template-columns: 1fr;
    }
    
    .stats-summary {
        grid-template-columns: 1fr;
    }
    
    .date-grid {
        grid-template-columns: repeat(4, 1fr);
    }
    
    .time-slots-grid {
        grid-template-columns: 1fr;
    }
    
    .selected-slot-action {
        flex-direction: column;
        gap: 1rem;
    }
}
</style>

<script>
let selectedSlot = null;
const venueId = '<?= $venue_id ?>';
const courtId = '<?= $court_id ?>';
const currentDate = '<?= $date ?>';

function loadCourts(venueId) {
    if (!venueId) {
        document.getElementById('court_id').innerHTML = '<option value="">Select Court</option>';
        return;
    }
    
    // Show loading state
    const courtSelect = document.getElementById('court_id');
    courtSelect.innerHTML = '<option value="">Loading courts...</option>';
    courtSelect.disabled = true;
    
    fetch(`/admin/public/api/get-courts.php?venue_id=${venueId}`)
        .then(r => {
            if (!r.ok) throw new Error('Failed to load courts');
            return r.json();
        })
        .then(data => {
            let options = '<option value="">Select Court</option>';
            if (data.courts && data.courts.length > 0) {
                data.courts.forEach(court => {
                    options += `<option value="${court.id}">${court.name} (Court #${court.court_number})</option>`;
                });
            } else {
                options = '<option value="">No courts available</option>';
            }
            courtSelect.innerHTML = options;
            courtSelect.disabled = false;
        })
        .catch(err => {
            console.error('Error loading courts:', err);
            courtSelect.innerHTML = '<option value="">Error loading courts</option>';
            courtSelect.disabled = false;
        });
}

function selectSlot(element) {
    // Remove previous selection
    document.querySelectorAll('.time-slot.selected').forEach(slot => {
        slot.classList.remove('selected');
    });
    
    // Add selection
    element.classList.add('selected');
    selectedSlot = {
        start: element.dataset.start,
        end: element.dataset.end
    };
    
    // Show action bar
    document.getElementById('selectedTime').textContent = 
        formatTime(selectedSlot.start) + ' - ' + formatTime(selectedSlot.end);
    document.getElementById('selectedSlotAction').style.display = 'flex';
}

function bookSlotDirect(button) {
    const slot = button.closest('.time-slot');
    const start = slot.dataset.start;
    const end = slot.dataset.end;
    
    if (!venueId || !courtId || !currentDate) {
        alert('Please select venue and court first');
        return;
    }
    
    const url = `/admin/bookings/create-offline?venue_id=${venueId}&court_id=${courtId}&date=${currentDate}&start_time=${start}&end_time=${end}`;
    window.location.href = url;
}

function formatTime(time) {
    const [h, m] = time.split(':');
    const hour = parseInt(h);
    const ampm = hour >= 12 ? 'PM' : 'AM';
    const hour12 = hour % 12 || 12;
    return `${hour12}:${m} ${ampm}`;
}

function bookSelectedSlot() {
    if (!selectedSlot) {
        alert('Please select a time slot first');
        return;
    }
    
    const url = `/admin/bookings/create-offline?venue_id=${venueId}&court_id=${courtId}&date=${currentDate}&start_time=${selectedSlot.start}&end_time=${selectedSlot.end}`;
    window.location.href = url;
}

function changeDate(days) {
    if (!venueId || !courtId) {
        alert('Please select venue and court first');
        return;
    }
    
    const newDate = new Date(currentDate);
    newDate.setDate(newDate.getDate() + days);
    const dateStr = newDate.toISOString().split('T')[0];
    window.location.href = `?venue_id=${venueId}&court_id=${courtId}&date=${dateStr}`;
}

// Auto-refresh every 2 minutes to show updated booking status
if (venueId && courtId) {
    setTimeout(() => {
        window.location.reload();
    }, 120000); // 2 minutes
}
</script>
